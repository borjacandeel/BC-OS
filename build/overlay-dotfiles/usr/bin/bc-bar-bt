#!/bin/sh
# Polybar: Bluetooth mínimo (apagado, encendido o dispositivo conectado)
command -v bluetoothctl >/dev/null || exit 0
show=$(timeout 2 bluetoothctl show 2>/dev/null)
[ -n "$show" ] || exit 0                       # sin adaptador: no mostrar nada
echo "$show" | grep -q "Powered: yes" || { echo "%{F#7F95A3}󰂲%{F-}"; exit 0; }
dev=$(timeout 2 bluetoothctl devices Connected 2>/dev/null | head -n1 | cut -d' ' -f3-)
if [ -n "$dev" ]; then echo "󰂱 $dev" | cut -c1-24; else echo "󰂯"; fi
