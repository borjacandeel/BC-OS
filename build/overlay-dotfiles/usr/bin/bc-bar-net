#!/bin/sh
# Polybar: red con el nombre de la Wi-Fi (o cable / sin conexión)
command -v nmcli >/dev/null || { echo "󰤮"; exit 0; }
line=$(nmcli -t -f TYPE,STATE,CONNECTION device 2>/dev/null | grep ':connected:' | head -n1)
case $line in
  wifi:*)
    ssid=${line#wifi:connected:}
    sig=$(nmcli -t -f ACTIVE,SIGNAL dev wifi 2>/dev/null | grep '^yes' | cut -d: -f2 | head -n1); sig=${sig:-0}
    if [ "$sig" -ge 75 ]; then i="󰤨"; elif [ "$sig" -ge 50 ]; then i="󰤥"; elif [ "$sig" -ge 25 ]; then i="󰤢"; else i="󰤟"; fi
    [ ${#ssid} -gt 14 ] && ssid="$(printf '%s' "$ssid" | cut -c1-13)…"
    echo "$i $ssid" ;;
  ethernet:*) echo "󰈀 Cable" ;;
  "") echo "%{F#7F95A3}󰤮 Sin red%{F-}" ;;
  *) echo "󰛳" ;;
esac
