# dunst — notificaciones del entorno «Dotfiles» de BC OS (dunst >= 1.12)
[global]
    monitor = 0
    follow = mouse
    origin = top-right
    width = (250, 340)
    height = (0, 300)
    offset = (14, 40)
    format = "<b>%s</b>\n%b"
    alignment = left
    markup = full
    stack_duplicates = true
    show_indicators = no
    icon_theme = "MacOS-Like-Dark, Qogir"
    enable_recursive_icon_lookup = true
    icon_position = left
    max_icon_size = 40
    font = CaskaydiaCove Nerd Font 10
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#8FC3D4"
    separator_color = frame
    corner_radius = 10
    sticky_history = yes
    history_length = 20
    progress_bar = true
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/xdg-open
    title = Dunst
    class = Dunst
[urgency_low]
    background = "#0E1B26"
    foreground = "#EAF1F5"
    timeout = 6
[urgency_normal]
    background = "#0E1B26"
    foreground = "#EAF1F5"
    timeout = 8
[urgency_critical]
    background = "#2A1519"
    foreground = "#EAF1F5"
    frame_color = "#E2AAA0"
    timeout = 0
