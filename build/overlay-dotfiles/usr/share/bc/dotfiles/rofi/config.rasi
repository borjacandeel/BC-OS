/* rofi — lanzador del entorno «Dotfiles» de BC OS (compatible con rofi 1.7 y 2.x) */
configuration {
    modi: "drun,run,window";
    font: "CaskaydiaCove Nerd Font 12";
    show-icons: true;
    icon-theme: "MacOS-Like-Dark";
    terminal: "bc-terminal";
    drun-display-format: "{name}";
    display-drun: "  Apps ";
    display-run: "  Ejecutar ";
    display-window: "  Ventanas ";
}
* {
    bg: #0E1B26EE;
    bg-alt: #1B2B3A;
    fg: #EAF1F5;
    fg-alt: #7F95A3;
    accent: #8FC3D4;
    background-color: transparent;
    text-color: @fg;
}
window {
    width: 40%;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    background-color: @bg;
    padding: 18px;
}
mainbox { children: [inputbar, listview]; spacing: 14px; }
inputbar { background-color: @bg-alt; border-radius: 8px; padding: 10px 14px; children: [prompt, entry]; spacing: 10px; }
prompt { text-color: @accent; }
entry { placeholder: "Buscar…"; placeholder-color: @fg-alt; }
listview { columns: 1; lines: 8; spacing: 4px; fixed-height: false; dynamic: true; }
element { padding: 8px 12px; border-radius: 8px; spacing: 10px; }
element-icon { size: 26px; }
element selected { background-color: @accent; text-color: #0E1B26; }
