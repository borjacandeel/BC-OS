# BC OS — configuración de sway (compositor Wayland). Sistema; personaliza en ~/.config/bc/sway-user.conf
# Súper = tecla Windows. Lista completa: /etc/bc/atajos.txt
set $mod Mod4
set $term bc-terminal

# Aspecto: el panel (bc-shell --panel) dibuja barra, Dock y fondo; las apps de BC dibujan su propio título
# Barra de título de sway en las ventanas que no son de BC (el panel dibuja encima el semáforo a la izquierda, como macOS).
# Las apps de BC llevan su propio marco y semáforo (border none). Borde fino en mosaico y de 6 px en flotante para redimensionar.
default_border normal 1
# Flotantes: borde fino de 1 px como el filo de las ventanas de macOS (redimensionar: Ctrl + arrastrar con el derecho o por el borde)
default_floating_border normal 1
titlebar_border_thickness 0
titlebar_padding 12 8
title_align center
# Golden Gate (oscuro): barra de título unificada con el fondo de la ventana; la activa más clara y con texto
# blanco, las inactivas apagadas (marcada diferencia activa/inactiva). bc-appearance las cambia a claro en caliente.
client.focused          #4A4A50 #2C2C31 #ECECEE #2C2C31 #4A4A50
client.focused_inactive #36363B #1F1F23 #7D7D83 #1F1F23 #36363B
client.unfocused        #36363B #1F1F23 #7D7D83 #1F1F23 #36363B
client.urgent           #FF5F57 #1B2740 #E8ECF5 #FF5F57 #FF5F57
font pango:Inter Semi-Bold 10
# Como macOS: el foco solo cambia al hacer clic (pasar el puntero no activa ventanas)
focus_follows_mouse no
mouse_warping none
popup_during_fullscreen smart
xwayland enable
# El fondo (swaybg) lo añade bc-wm-mode al generar la configuración: el elegido en Configuración o el predeterminado
seat * xcursor_theme McMojave-cursors 24
workspace_auto_back_and_forth no

# (el teclado, el modo y ~/.config/bc/sway-user.conf los añade bc-wm-mode al generar la configuración final)
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

# --- Aplicaciones ---
bindsym Ctrl+Return exec $term
bindsym $mod+Return exec $term
bindsym Ctrl+b exec firefox
bindsym $mod+b exec firefox
bindsym $mod+e exec bc-shell --app files
# Golden Gate: Spotlight (Ctrl/Súper+Espacio), Aplicaciones (F4), Mission Control (Ctrl+↑, F3), Centro de notificaciones
bindsym Ctrl+space exec bc-ctl spotlight
bindsym $mod+space exec bc-ctl spotlight
bindsym F4 exec bc-ctl launchpad
bindsym $mod+a exec bc-ctl launchpad
bindsym F3 exec bc-ctl mission
bindsym Ctrl+Up exec bc-ctl mission
bindsym $mod+n exec bc-ctl notifications
bindsym F11 exec bc-ctl desktop
bindsym $mod+c exec bc-ctl center
bindsym $mod+v exec bc-ctl clipboard
bindsym Ctrl+$mod+q exec bc-ctl lock
bindsym $mod+Shift+e exec bc-ctl power logout
bindsym $mod+F1 exec mousepad /etc/bc/atajos.txt

# --- Ventanas ---
# Cerrar con la animación de macOS (el panel captura, cierra y desvanece)
bindsym $mod+q exec bc-ctl close
bindsym Ctrl+q exec bc-ctl close
bindsym $mod+f fullscreen toggle
bindsym $mod+m exec bc-ctl minimize
bindsym $mod+Shift+m scratchpad show
bindsym $mod+Shift+f floating toggle
bindsym $mod+Shift+space exec bc-wm-mode toggle
bindsym $mod+Shift+r reload

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
# Ctrl + flechas: cambiar de ventana en esa dirección (en mosaico y en flotante); con Mayús, mover la ventana
# Como en macOS: Ctrl+←/→ cambia de escritorio (Ctrl+↑ es Mission Control); el foco se mueve con Súper+flechas
bindsym Ctrl+Left workspace prev_on_output
bindsym Ctrl+Right workspace next_on_output
bindsym Ctrl+Down exec bc-ctl mission
bindsym Ctrl+Shift+Left move left
bindsym Ctrl+Shift+Right move right
bindsym Ctrl+Shift+Up move up
bindsym Ctrl+Shift+Down move down
# Selector de aplicaciones (como ⌘Tab)
bindsym Alt+Tab exec bc-ctl switcher
bindsym Alt+Shift+Tab exec bc-ctl switcher-back
bindsym $mod+Tab exec bc-ctl switcher
# Gestos del trackpad (sway: discretos, se disparan al terminar el gesto)
bindgesture swipe:3:up exec bc-ctl mission
bindgesture swipe:3:down exec bc-ctl desktop
bindgesture swipe:3:left workspace next_on_output
bindgesture swipe:3:right workspace prev_on_output
bindgesture swipe:4:up exec bc-ctl launchpad
bindgesture pinch:4:inward exec bc-ctl launchpad

# Mosaico (como bspwm): dividir y cambiar disposición
bindsym $mod+h splith
bindsym $mod+Shift+v splitv
bindsym $mod+t layout toggle split
bindsym $mod+r mode "redimensionar"
mode "redimensionar" {
    bindsym Left resize shrink width 40px
    bindsym Right resize grow width 40px
    bindsym Up resize shrink height 40px
    bindsym Down resize grow height 40px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
# Mantén Ctrl y arrastra con el botón izquierdo para mover la ventana y con el derecho para redimensionarla
floating_modifier Ctrl normal

# Escritorios
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Ctrl+Right workspace next
bindsym $mod+Ctrl+Left workspace prev


# Ctrl + número: cambiar de escritorio · Ctrl+Mayús + número: llevar la ventana
bindsym Ctrl+1 workspace number 1
bindsym Ctrl+Shift+1 move container to workspace number 1
bindsym Ctrl+2 workspace number 2
bindsym Ctrl+Shift+2 move container to workspace number 2
bindsym Ctrl+3 workspace number 3
bindsym Ctrl+Shift+3 move container to workspace number 3
bindsym Ctrl+4 workspace number 4
bindsym Ctrl+Shift+4 move container to workspace number 4
bindsym Ctrl+5 workspace number 5
bindsym Ctrl+Shift+5 move container to workspace number 5
bindsym Ctrl+6 workspace number 6
bindsym Ctrl+Shift+6 move container to workspace number 6
bindsym Ctrl+7 workspace number 7
bindsym Ctrl+Shift+7 move container to workspace number 7
bindsym Ctrl+8 workspace number 8
bindsym Ctrl+Shift+8 move container to workspace number 8
bindsym Ctrl+9 workspace number 9
bindsym Ctrl+Shift+9 move container to workspace number 9

# Teclas multimedia y capturas
bindsym --locked XF86AudioRaiseVolume exec sh -c 'wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; bc-ctl osd volume'
bindsym --locked XF86AudioLowerVolume exec sh -c 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; bc-ctl osd volume'
bindsym --locked XF86AudioMute exec sh -c 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; bc-ctl osd volume'
bindsym --locked XF86MonBrightnessUp exec sh -c 'brightnessctl -c backlight set 5%+; bc-ctl osd brightness'
bindsym --locked XF86MonBrightnessDown exec sh -c 'brightnessctl -c backlight set 5%-; bc-ctl osd brightness'
bindsym Print exec bc-screenshot pantalla
bindsym $mod+Shift+s exec bc-screenshot area
bindsym Alt+Print exec bc-screenshot ventana

# Ventanas que siempre flotan
# Como macOS: TODAS las apps Wayland dibujan su propia ventana (semáforo a la izquierda, esquinas redondeadas,
# redimensionables desde el borde): GTK con el tema MacTahoe, Qt con «adwaita», Firefox con bc-firefox.css.
# Las X11 (XWayland) mantienen el marco de sway.
for_window [shell="xdg_shell" app_id="^(?!bc-)"] border csd
for_window [app_id="bc-.*"] border none
# Firefox dibuja su barra (pestañas, semáforo y esquinas redondeadas): sin marco de sway
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable

# Pantalla: se adapta sola al tamaño de la ventana de la máquina virtual o al monitor
exec bc-display watch
# VirtualBox: portapapeles compartido con el anfitrión (si las Guest Additions están instaladas)
exec sh -c 'command -v VBoxClient >/dev/null && systemd-detect-virt -q --vm && VBoxClient --clipboard'

# Historial del portapapeles, bloqueo por inactividad y apagado de pantalla
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec swayidle -w timeout 600 'bc-ctl lock' timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' before-sleep 'bc-ctl lock'

# Panel de BC Shell (barra, Dock, fondo, notificaciones); se relanza si termina
# Si el panel se cae con la pantalla bloqueada, swaylock la protege al instante (bloqueo seguro ext-session-lock)
exec sh -c 'while [ -S "$SWAYSOCK" ]; do bc-shell --panel; [ -f "$XDG_RUNTIME_DIR/bc-bloqueado" ] && swaylock -f -c 0B1020 -e -F; sleep 1; done'
