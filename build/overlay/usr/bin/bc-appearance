#!/bin/sh
# Aplica el aspecto claro u oscuro de BC OS en caliente a todo el sistema: barras de título de sway,
# apps GTK (gsettings y settings.ini), Qt (qt6ct si está) y lo recuerda para el próximo inicio. Uso: bc-appearance dark|light|auto
D="${XDG_CONFIG_HOME:-$HOME/.config}/bc"; mkdir -p "$D"
m="$1"
if [ "$m" = auto ]; then h=$(date +%H); if [ "$h" -ge 8 ] && [ "$h" -lt 20 ]; then m=light; else m=dark; fi; fi
[ "$m" = light ] || m=dark
echo "$m" > "$D/appearance"
if [ "$m" = light ]; then
  scheme=prefer-light; gtk=Adwaita; [ -d /usr/share/themes/MacTahoe-Light ] && gtk=MacTahoe-Light; dark=false
  cols='client.focused #C8C8CC #ECECEE #1D1D1F #ECECEE #C8C8CC; client.focused_inactive #D8D8DC #F6F6F7 #A1A1A6 #F6F6F7 #D8D8DC; client.unfocused #D8D8DC #F6F6F7 #A1A1A6 #F6F6F7 #D8D8DC'
else
  scheme=prefer-dark; gtk=Adwaita-dark; [ -d /usr/share/themes/MacTahoe-Dark ] && gtk=MacTahoe-Dark; dark=true
  cols='client.focused #4A4A50 #2C2C31 #ECECEE #2C2C31 #4A4A50; client.focused_inactive #36363B #1F1F23 #7D7D83 #1F1F23 #36363B; client.unfocused #36363B #1F1F23 #7D7D83 #1F1F23 #36363B'
fi
[ -n "$SWAYSOCK" ] && swaymsg "$cols" >/dev/null 2>&1
# Terminal: Alacritty recarga la paleta importada al instante; foot cambia de tema con una señal (USR1 oscuro, USR2 claro)
if [ "$m" = light ]; then pal=/etc/bc/alacritty-claro.toml; sig=USR2; else pal=/etc/bc/alacritty-oscuro.toml; sig=USR1; fi
[ -f "$pal" ] && cp "$pal" "$D/alacritty-colores.toml.tmp" && mv "$D/alacritty-colores.toml.tmp" "$D/alacritty-colores.toml"
pkill -"$sig" -x foot 2>/dev/null || true
if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface color-scheme "$scheme" 2>/dev/null
  gsettings set org.gnome.desktop.interface gtk-theme "$gtk" 2>/dev/null
fi
for v in 3.0 4.0; do
  f="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-$v/settings.ini"; mkdir -p "$(dirname "$f")"
  [ -f "$f" ] || printf '[Settings]\n' > "$f"
  if grep -q '^gtk-theme-name' "$f"; then sed -i "s/^gtk-theme-name=.*/gtk-theme-name=$gtk/" "$f"; else printf 'gtk-theme-name=%s\n' "$gtk" >> "$f"; fi
  if grep -q '^gtk-application-prefer-dark-theme' "$f"; then sed -i "s/^gtk-application-prefer-dark-theme=.*/gtk-application-prefer-dark-theme=$dark/" "$f"
  else printf 'gtk-application-prefer-dark-theme=%s\n' "$dark" >> "$f"; fi
done
bc-wm-mode init >/dev/null 2>&1 || true
exit 0
