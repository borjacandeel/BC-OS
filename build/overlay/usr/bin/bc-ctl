#!/bin/sh
# Controla el panel de BC Shell por D-Bus (lo usan los atajos de sway). Uso: bc-ctl launcher|center|lock|tiling|style <mac|win>|welcome|power <acción>
# Golden Gate: bc-ctl spotlight|mission|switcher|switcher-back|launchpad|notifications|minimize|appearance|desktop
case "$1" in
  launcher) m=ToggleLauncher; set -- ;;
  center)   m=ToggleControlCenter; set -- ;;
  lock)     m=Lock; set -- ;;
  tiling)   exec bc-wm-mode toggle ;;
  welcome)  m=ShowWelcome; set -- ;;
  clipboard) m=ToggleClipboard; set -- ;;
  osd)      [ -n "$2" ] || exit 2; m=ShowOsd; a="$2"; set -- s "$a" ;;
  style)    [ -n "$2" ] || { echo "uso: bc-ctl style <mac|win|minimal>" >&2; exit 2; }; m=SetStyle; a="$2"; set -- s "$a" ;;
  option)   [ -n "$3" ] || { echo "uso: bc-ctl option <clave> <valor>" >&2; exit 2; }; m=SetOption; k="$2"; v="$3"; set -- ss "$k" "$v" ;;
  power)    m=Power; a="$2"; set -- s "$a" ;;
  thumb)    [ -f "$2" ] || exit 2; m=Action; a="thumb:$2"; set -- s "$a" ;;   # miniatura flotante de una captura
  spotlight|mission|switcher|switcher-back|launchpad|notifications|minimize|close|appearance|desktop|forcequit|emoji|screenshot|recording-on|recording-off) m=Action; a="$1"; set -- s "$a" ;;
  *) echo "uso: bc-ctl launcher|center|lock|tiling|welcome|style <mac|win|minimal>|option <clave> <valor>|power <poweroff|reboot|suspend|logout>" >&2; exit 2 ;;
esac
exec busctl --user call org.bcos.Shell /org/bcos/Shell org.bcos.Shell "$m" "$@"
