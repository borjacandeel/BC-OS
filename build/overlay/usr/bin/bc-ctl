#!/bin/sh
# Controla el panel de BC Shell por D-Bus (lo usan los atajos de sway). Uso: bc-ctl launcher|center|lock|tiling|style <mac|win>|power <acción>
case "$1" in
  launcher) m=ToggleLauncher; set -- ;;
  center)   m=ToggleControlCenter; set -- ;;
  lock)     m=Lock; set -- ;;
  tiling)   exec bc-wm-mode toggle ;;
  style)    m=SetStyle; a="$2"; set -- s "$a" ;;
  power)    m=Power; a="$2"; set -- s "$a" ;;
  *) echo "uso: bc-ctl launcher|center|lock|tiling|power <poweroff|reboot|suspend|logout>" >&2; exit 2 ;;
esac
exec busctl --user call org.bcos.Shell /org/bcos/Shell org.bcos.Shell "$m" "$@"
