#!/bin/sh
# Resolución de pantalla de BC OS. Uso: bc-display auto | list | set <AnchoxAlto> | hz | hz-set <Hz|auto> | escala <1…2|auto> | watch
#  auto  : aplica el modo preferido (el que anuncia el monitor o la ventana de la máquina virtual)
#  watch : vigila cambios de pantalla (DRM) y aplica «auto»; así la ventana de VirtualBox/QEMU se adapta al redimensionarla
cmd="${1:-auto}"
# Copia para la pantalla de inicio de sesión (usuario «greeter»): la misma resolución, frecuencia y escala
para_login() {
  [ -d /var/lib/bc-greeter ] && [ -w /var/lib/bc-greeter ] || return 0
  f="/var/lib/bc-greeter/pantalla-$(id -un)"
  { echo "resolucion=$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/bc/resolucion" 2>/dev/null)"
    echo "frecuencia=$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/bc/frecuencia" 2>/dev/null)"
    echo "escala=$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/bc/escala" 2>/dev/null)"; } > "$f.tmp" 2>/dev/null && mv -f "$f.tmp" "$f"
  ln -sfn "$f" /var/lib/bc-greeter/pantalla 2>/dev/null || true
}

# Frecuencia elegida por el usuario (Ajustes ▸ Pantallas); sin ella, la más alta que admita el monitor
GHZ="${XDG_CONFIG_HOME:-$HOME/.config}/bc/frecuencia"
fhz="$(cat "$GHZ" 2>/dev/null)"; case "$fhz" in [0-9][0-9]|[0-9][0-9][0-9]) ;; *) fhz= ;; esac
# Escala de la interfaz (Ajustes ▸ Pantallas ▸ Tamaño): 1, 1.25, 1.5, 1.75 o 2; sin elegir, automática según los ppp
GESC="${XDG_CONFIG_HOME:-$HOME/.config}/bc/escala"
if [ "$cmd" = escala ]; then
  mkdir -p "$(dirname "$GESC")"
  case "$2" in 1|1.25|1.5|1.75|2) echo "$2" > "$GESC" ;; *) rm -f "$GESC" ;; esac
  para_login; exec "$0" inicio
fi
if [ "$cmd" = hz-set ]; then
  mkdir -p "$(dirname "$GHZ")"
  case "$2" in [0-9][0-9]|[0-9][0-9][0-9]) echo "$2" > "$GHZ" ;; *) rm -f "$GHZ" ;; esac
  para_login; exec "$0" inicio
fi
# Hyprland: la frecuencia más alta la pone su configuración («highrr»); aquí solo la resolución elegida por el usuario
if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
  G="${XDG_CONFIG_HOME:-$HOME/.config}/bc/resolucion"
  HE="$(cat "$GESC" 2>/dev/null)"; case "$HE" in 1|1.25|1.5|1.75|2) ;; *) HE=1 ;; esac
  hmode() { hyprctl eval "hl.monitor({ output = \"\", mode = \"$1\", position = \"auto\", scale = \"$HE\" })" >/dev/null 2>&1; }
  R="${fhz:-60}"
  # Frecuencia elegida sin resolución elegida: la resolución actual del monitor a esa frecuencia
  actual() { hyprctl monitors -j 2>/dev/null | jq -r '.[0] | "\(.width)x\(.height)"'; }
  case "${1:-auto}" in
    set) case "$2" in [0-9]*x[0-9]*) mkdir -p "$(dirname "$G")"; echo "$2" > "$G"; para_login; exec "$0" inicio ;; *) exit 2 ;; esac ;;
    auto) [ "${2:-}" = olvidar ] && { rm -f "$G"; para_login; }; exec "$0" inicio ;;
    inicio|watch)
      # Cada pantalla a su resolución nativa (la primera que anuncia) y su frecuencia más alta; la principal (digital
      # más grande: HDMI/DP/eDP antes que VGA/DVI, o ~/.config/bc/pantalla-principal) a la izquierda en 0,0 y con el
      # foco, para que la barra, los widgets y las ventanas nuevas (el instalador) salgan ahí y no en la secundaria
      w="$(cat "$G" 2>/dev/null)"; case "$w" in [0-9]*x[0-9]*) ;; *) w= ;; esac
      pri="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/bc/pantalla-principal" 2>/dev/null)"
      x=0; first=
      for n in $(hyprctl monitors all -j 2>/dev/null | jq -r --arg p "$pri" 'sort_by((if .name == $p then 0 else 1 end),
            (if (.name | test("^(VGA|DVI-A)"; "i")) then 1 else 0 end), -(.width * .height)) | .[].name'); do
        m="$(hyprctl monitors all -j 2>/dev/null | jq -c --arg n "$n" '.[] | select(.name == $n)')"
        nat="$(echo "$m" | jq -r '(.availableModes[0] // "") | sub("@.*"; "")')"
        [ -n "$nat" ] || nat="$(echo "$m" | jq -r '"\(.width)x\(.height)"')"
        res="$nat"; [ -z "$first" ] && [ -n "$w" ] && res="$w"
        best="$(echo "$m" | jq -r --arg r "$res" '[.availableModes[] | select(startswith($r + "@")) | sub(".*@"; "") | sub("Hz"; "") | tonumber] | max // 60')"
        hz="${fhz:-$best}"
        hyprctl eval "hl.monitor({ output = \"$n\", mode = \"$res@$hz\", position = \"${x}x0\", scale = \"$HE\" })" >/dev/null 2>&1
        x=$(awk -v a="$x" -v w="${res%x*}" -v e="$HE" 'BEGIN { printf "%d", a + w / e }')
        [ -n "$first" ] || first="$n"
      done
      [ -n "$first" ] && hyprctl eval "hl.dispatch(hl.dsp.focus({ monitor = \"$first\" }))" >/dev/null 2>&1
      [ "$1" = watch ] || exit 0
      # Pantallas que se conectan o cambian después: se vuelve a ordenar
      antes="$(hyprctl monitors all -j 2>/dev/null | jq -r '[.[].name] | join(" ")')"
      udevadm monitor --udev --subsystem-match=drm 2>/dev/null | while read -r _; do
        sleep 1; ahora="$(hyprctl monitors all -j 2>/dev/null | jq -r '[.[].name] | join(" ")')"
        [ "$ahora" = "$antes" ] && continue; antes="$ahora"; "$0" inicio
      done ;;
    seguir) hmode preferred ;;
    list) hyprctl monitors -j 2>/dev/null | jq -r '.[0].availableModes[]' | sed 's/@.*//' | sort -u -t x -k1,1nr -k2,2nr ;;
    hz) hyprctl monitors -j 2>/dev/null | jq -r '.[0] as $m | $m.availableModes[] | select(startswith("\($m.width)x\($m.height)@"))
          | sub(".*@"; "") | sub("Hz"; "") | tonumber | round' | sort -un -r ;;
  esac
  exit 0
fi
outs() { swaymsg -t get_outputs -r 2>/dev/null; }
# Resolución elegida por el usuario (Ajustes ▸ Pantallas): se recuerda y se vuelve a aplicar al iniciar sesión
GUARDADA="${XDG_CONFIG_HOME:-$HOME/.config}/bc/resolucion"
case "$cmd" in
  list) outs | jq -r '.[] | select(.active) | .modes[] | "\(.width)x\(.height)"' | sort -u -t x -k1,1nr -k2,2nr ;;
  hz) outs | jq -r '[.[] | select(.active)][0] as $o | $o.modes[] | select(.width == $o.current_mode.width and .height == $o.current_mode.height)
        | (.refresh / 1000 | round)' | sort -un -r ;;
  set)
    case "$2" in [0-9]*x[0-9]*) ;; *) echo "uso: bc-display set 1920x1080" >&2; exit 2 ;; esac
    mkdir -p "$(dirname "$GUARDADA")"; echo "$2" > "$GUARDADA"
    # Aplica con la frecuencia elegida (o la más alta); si el monitor o la pantalla virtual no anuncia ese modo, se
    # fuerza como modo propio (--custom), p. ej. las resoluciones de MacBook (1470 × 956…) en una máquina virtual
    para_login; exec "$0" inicio ;;
  auto|inicio|seguir)
    # «auto» desde Ajustes olvida la resolución guardada; al iniciar sesión («inicio») se respeta.
    # «seguir»: la ventana de la máquina virtual cambió de tamaño (pantalla completa, redimensionar): se adapta a ella
    [ "$cmd" = auto ] && [ "${2:-}" = olvidar ] && { rm -f "$GUARDADA"; para_login; }
    want="$(cat "$GUARDADA" 2>/dev/null)"; [ "$cmd" = seguir ] && want=; case "$want" in [0-9]*x[0-9]*) ;; *) want= ;; esac
    ww="${want%x*}"; wh="${want#*x}"; [ -n "$want" ] || { ww=0; wh=0; }
    # Resolución nativa (la del primer modo) a la frecuencia MÁS ALTA que admita el monitor (60, 100, 120, 144 Hz…):
    # el compositor y las animaciones de BC van a esa frecuencia
    outs | jq -r --argjson ww "${ww:-0}" --argjson wh "${wh:-0}" --argjson hz "${fhz:-0}" '.[] | select(.active) | . as $o
      | ([$o.modes[] | select(.width == $ww and .height == $wh)] | if length > 0 then .[0]
          elif $ww > 0 then {width: $ww, height: $wh, refresh: 60000} else $o.modes[0] end) as $m0
      | ([$o.modes[] | select(.width == $m0.width and .height == $m0.height) | .refresh]) as $rs
      | (if $hz > 0 then ([$rs[] | select(((. / 1000) - $hz | fabs) < 1.5)] | max) else null end) as $rq
      | ($rq // ($rs | max) // 60000) as $r
      | "\($o.name) \($m0.width) \($m0.height) \($r) \($o.current_mode.width) \($o.current_mode.height) \($o.current_mode.refresh) \($o.physical_width // 0)"' |
    while read -r n w h r cw ch cr pw; do
      [ -n "$w" ] && [ "$w" != "null" ] || continue
      if [ "$w" != "$cw" ] || [ "$h" != "$ch" ] || [ "$r" != "$cr" ]; then
        hz=$(awk -v r="$r" 'BEGIN { printf "%.3f", r/1000 }')
        swaymsg "output $n mode ${w}x${h}@${hz}Hz" >/dev/null 2>&1 || swaymsg "output $n mode --custom ${w}x${h}@${hz}Hz" >/dev/null 2>&1
      fi
      # Escala: la elegida en Ajustes; si no, según los puntos por pulgada reales del monitor (tamaño físico en mm)
      # como macOS: ~110 ppp → 1, ~140 → 1.25, ~180 → 1.5, Retina (≥ 215) → 2. Sin tamaño físico (máquinas
      # virtuales), 2 desde 2400 px de ancho (Retina/HiDPI) y 1 por debajo.
      esc="$(cat "$GESC" 2>/dev/null)"
      if [ -z "$esc" ]; then
        if [ "${pw:-0}" -gt 0 ] 2>/dev/null; then
          esc=$(awk -v w="$w" -v mm="$pw" 'BEGIN { d = w * 25.4 / mm; if (d < 135) print 1; else if (d < 175) print 1.25; else if (d < 215) print 1.5; else print 2 }')
        elif [ "$w" -ge 2400 ]; then esc=2; else esc=1; fi
      fi
      case "$esc" in *[!0-9.]*) esc=1 ;; esac
      swaymsg "output $n scale $esc" >/dev/null
    done
    # Varias pantallas: la principal (digital más grande: HDMI/DP/eDP antes que VGA/DVI) a la izquierda en 0,0 y con el
    # foco (ahí se abren las ventanas); el resto a su derecha. ~/.config/bc/pantalla-principal fija otra por nombre.
    pri="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/bc/pantalla-principal" 2>/dev/null)"
    outs | jq -r --arg p "$pri" '[.[] | select(.active)] | sort_by(
        (if .name == $p then 0 else 1 end),
        (if (.name | test("^(VGA|DVI-A)"; "i")) then 1 else 0 end),
        -(.rect.width * .rect.height)) | .[] | "\(.name) \(.rect.width)"' |
    { x=0; first=; while read -r n w; do
        swaymsg "output $n position $x 0" >/dev/null; x=$((x + w)); [ -n "$first" ] || first=$n
      done; [ "$x" -gt 0 ] && [ -n "$first" ] && swaymsg "focus output $first" >/dev/null; } ;;
  watch)
    bc-display inicio
    # En máquina virtual, al cambiar el tamaño de su ventana (pantalla completa) se sigue a la ventana, como macOS en
    # una VM; en equipo físico (monitor conectado), se vuelve a aplicar la resolución elegida
    # (solo si cambia el tamaño preferido que anuncia la pantalla: los cambios de modo propios no cuentan)
    vm=0; [ "${BC_EQUIPO:-}" = vm ] && vm=1
    pref() { outs | jq -r '[.[] | select(.active) | "\(.name):\(.modes[0].width)x\(.modes[0].height)"] | join(" ")'; }
    antes="$(pref)"
    udevadm monitor --udev --subsystem-match=drm 2>/dev/null | while read -r _; do
      sleep 1; ahora="$(pref)"; [ "$ahora" = "$antes" ] && continue; antes="$ahora"
      if [ $vm = 1 ]; then bc-display seguir; else bc-display inicio; fi
    done ;;
  *) echo "uso: bc-display auto|list|set <AnchoxAlto>|watch" >&2; exit 2 ;;
esac
