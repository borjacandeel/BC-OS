#!/bin/sh
# Controladores al instalar BC OS en un equipo real (primer arranque con Internet; se desactiva al terminar):
#  · Gráficas: Intel (VA-API, Vulkan), AMD (Vulkan) y NVIDIA (firmware completo de nouveau, también el GSP de las
#    series 20 en adelante que la ISO no lleva por tamaño).
#  · Wi-Fi/Bluetooth Qualcomm y el resto del firmware que se quitó de la ISO.
#  · Portátiles: perfiles de energía y control térmico de Intel.
# Registro en /var/log/bc-drivers.log. Uso manual: sudo bc-drivers
LOG=/var/log/bc-drivers.log
exec >>"$LOG" 2>&1
echo "== $(date) =="
[ "$(id -u)" = 0 ] || { echo "hace falta root"; exit 1; }
systemd-detect-virt -q --vm 2>/dev/null && { echo "máquina virtual: nada que instalar"; systemctl disable bc-drivers.service 2>/dev/null; exit 0; }
# Esperar a la red (hasta 2 min)
# (por HTTPS, no con ping: muchas redes bloquean ICMP y entonces nunca se instalaba nada)
enlinea() { curl -sfI --max-time 6 https://archlinux.org >/dev/null 2>&1 || ping -c1 -W2 archlinux.org >/dev/null 2>&1; }
for i in $(seq 40); do enlinea && break; sleep 3; done
enlinea || { echo "sin Internet: se reintenta en el próximo arranque"; exit 0; }
GPU="$(lspci -nn 2>/dev/null | grep -iE 'vga|3d|display')"
echo "GPU: $GPU"
# Base para cualquier equipo: firmware, región Wi-Fi (sin wireless-regdb el kernel no carga regulatory.db y el Wi-Fi
# va limitado), sonido de portátiles modernos (SOF), Bluetooth y utilidades de vídeo
PK="linux-firmware linux-firmware-qcom linux-firmware-other wireless-regdb sof-firmware alsa-firmware alsa-ucm-conf bluez bluez-utils mesa mesa-utils vulkan-mesa-layers"
REINST=""
echo "$GPU" | grep -qi intel && PK="$PK vulkan-intel intel-media-driver libva-intel-driver libva-utils"
echo "$GPU" | grep -qiE 'amd|ati|radeon' && PK="$PK vulkan-radeon libva-utils"
echo "$GPU" | grep -qi nvidia && { PK="$PK vulkan-nouveau linux-firmware-nvidia"; }
# Wi-Fi Broadcom antiguo (BCM43xx sin firmware libre): controlador wl
lspci -nn 2>/dev/null | grep -qiE "network.*broadcom|broadcom.*802\.11" && PK="$PK broadcom-wl"
grep -qi intel /proc/cpuinfo && PK="$PK intel-ucode thermald"
grep -qi amd /proc/cpuinfo && PK="$PK amd-ucode"
ls /sys/class/power_supply/BAT* >/dev/null 2>&1 && PK="$PK power-profiles-daemon"
# Solo lo que falte (cada equipo y cada actualización lo comprueba: si cambias de equipo o de gráfica, se completa)
pacman -Sy --noconfirm >/dev/null 2>&1 || true
# (los que no existen en esta arquitectura, p. ej. sof-firmware en ARM, se ignoran: si no, se reintentarían siempre)
FALTA="$(for p in $(pacman -T $PK 2>/dev/null); do pacman -Si "$p" >/dev/null 2>&1 && echo "$p"; done | tr '\n' ' ')"
if [ -z "$(echo "$FALTA" | tr -d ' ')" ]; then echo "todos los controladores ya están instalados"; echo "hecho $(date)"; systemctl disable bc-drivers.service 2>/dev/null; exit 0; fi
echo "faltan: $FALTA"
# (paquete a paquete si alguno no existe en esta arquitectura, para que no bloquee al resto)
pacman -S --noconfirm --needed $FALTA || for p in $FALTA; do pacman -S --noconfirm --needed "$p" || echo "AVISO: no se pudo instalar $p"; done
command -v thermald >/dev/null 2>&1 && systemctl enable --now thermald 2>/dev/null
systemctl enable --now bluetooth.service 2>/dev/null
command -v powerprofilesctl >/dev/null 2>&1 && systemctl enable --now power-profiles-daemon 2>/dev/null
# Microcódigo y firmware nuevos: initramfs al día
mkinitcpio -P || true
systemctl disable bc-drivers.service
echo "hecho $(date)"
