#!/bin/sh
# Pantalla de login de BC OS: cage (kiosco Wayland) + bc-greeter, con render por software.
# Si el greeter falla varias veces seguidas se marca /run/bc-greeter/failed y
# bc-login-fallback.path arranca el autologin de tty1 para no dejar la máquina inservible.
D=/run/bc-greeter
n=$(cat "$D/count" 2>/dev/null); n=$(( ${n:-0} + 1 ))
echo "$n" > "$D/count" 2>/dev/null
if [ "$n" -gt 3 ]; then
  : > "$D/failed" 2>/dev/null
  exec sleep 3600
fi
export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 QT_QUICK_BACKEND=software
export XCURSOR_THEME=McMojave-cursors XCURSOR_SIZE=24
export QT_QPA_PLATFORM=wayland XDG_SESSION_TYPE=wayland LANG="${LANG:-es_ES.UTF-8}" BC_GREETER_DIR="$D"
# La pantalla del login con la resolución, frecuencia y escala que eligió el último usuario (bc-display)
exec cage -s -- sh -c '
P=/var/lib/bc-greeter/pantalla
if [ -r "$P" ] && command -v wlr-randr >/dev/null 2>&1; then
  res=$(sed -n "s/^resolucion=//p" "$P"); hz=$(sed -n "s/^frecuencia=//p" "$P"); esc=$(sed -n "s/^escala=//p" "$P")
  o=$(wlr-randr 2>/dev/null | awk "NR==1{print \$1}")
  if [ -n "$o" ]; then
    case "$res" in [0-9]*x[0-9]*) m="$res"; [ -n "$hz" ] && m="$m@${hz}Hz"
      wlr-randr --output "$o" --mode "$m" 2>/dev/null || wlr-randr --output "$o" --custom-mode "$m" 2>/dev/null ;; esac
    case "$esc" in 1|1.25|1.5|1.75|2) wlr-randr --output "$o" --scale "$esc" 2>/dev/null ;; esac
  fi
fi
exec /usr/bin/bc-greeter'

