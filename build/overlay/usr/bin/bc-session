#!/bin/sh
# Sesión gráfica de BC OS: labwc (Wayland) + BC Shell. Respaldo por software si no hay GPU.
if ! ls /dev/dri/renderD* >/dev/null 2>&1; then
  export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 QT_QUICK_BACKEND=software
fi
export LANG="${LANG:-es_ES.UTF-8}" XDG_CURRENT_DESKTOP=BC XDG_SESSION_TYPE=wayland QT_QPA_PLATFORM=wayland
exec labwc
