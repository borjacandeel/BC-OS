#!/bin/sh
# Sesión gráfica de BC OS: sway (Wayland) + panel de BC Shell. Respaldo por software si no hay GPU.
# Alpha: render por software siempre, salvo que el kernel arranque con bc.gpu=1
if ! grep -qw "bc.gpu=1" /proc/cmdline || ! ls /dev/dri/renderD* >/dev/null 2>&1; then
  export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 QT_QUICK_BACKEND=software
fi
export LANG="${LANG:-es_ES.UTF-8}" XDG_CURRENT_DESKTOP=BC XDG_SESSION_TYPE=wayland QT_QPA_PLATFORM=wayland
LOG="$HOME/bc-session.log"
{ date; echo "renderD: $(ls /dev/dri 2>&1 | tr '\n' ' ')"; echo "WLR_RENDERER=$WLR_RENDERER QT_QUICK_BACKEND=$QT_QUICK_BACKEND"; } > "$LOG" 2>&1
bc-wm-mode init >> "$LOG" 2>&1
sway -c /etc/bc/sway/config >> "$LOG" 2>&1
rc=$?
echo "sway terminó con código $rc" >> "$LOG"
# Bajo greetd (--greetd) al cerrar sesión se vuelve al login; sin greetd (autologin) queda un terminal.
{ [ "$1" = "--greetd" ] || [ -n "$BC_GREETD" ]; } && exit 0
echo "sway terminó con código $rc — revisa $LOG"
exec bash
