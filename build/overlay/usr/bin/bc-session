#!/bin/sh
# Sesión gráfica de BC OS.
#  · Con aceleración 3D (GPU real, VirtualBox x86 con «Aceleración 3D», QEMU con virgl): Hyprland, con animaciones
#    fluidas tipo macOS, desenfoque real y sombras. Si Hyprland falla al arrancar, sway por software.
#  · Sin aceleración, o en máquina virtual (VirtualBox, VMware…): sway con pixman, lo más ligero y fluido.
#    Opcional (Ajustes ▸ General, «si» en ~/.config/bc/esquinas): swayfx por software con esquinas en todas las ventanas.
#  bc.gpu=0 en el kernel (o «sway» en ~/.config/bc/compositor) fuerza sway; bc.gpu=1 o «hyprland», Hyprland.
# «BC clásico»: el escritorio anterior a Golden Gate, elegible en el login.
if [ "$1" = "--classic" ]; then export BC_CLASSIC=1; shift; fi
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/bc"
LOG="$HOME/bc-session.log"
export XCURSOR_THEME=McMojave-cursors XCURSOR_SIZE=24
# Firefox con sus propias decoraciones (pestañas en la barra, esquinas redondeadas y semáforo), como Safari
export MOZ_GTK_TITLEBAR_DECORATION=client
# Apps Qt de terceros: barra propia redondeada con los botones según GNOME (semáforo a la izquierda)
export QT_WAYLAND_DECORATION=adwaita
# Apps Qt de terceros: iconos (MacOS-Like), diálogos y paleta desde GTK, como el resto del sistema (BC Shell no lo usa)
[ -f /usr/lib/qt6/plugins/platformthemes/libqgtk3.so ] && export QT_QPA_PLATFORMTHEME=gtk3
export LANG="${LANG:-es_ES.UTF-8}" XDG_CURRENT_DESKTOP=BC XDG_SESSION_TYPE=wayland QT_QPA_PLATFORM=wayland

es_vm() {
  systemd-detect-virt --vm -q 2>/dev/null && return 0
  # GPU virtual (VirtualBox/VMware VMSVGA, virtio de QEMU/UTM, QXL, Bochs) o dispositivos PCI de hipervisor:
  # VirtualBox en Mac ARM no siempre tiene DMI ni lo detecta systemd-detect-virt
  for d in /sys/class/drm/card*/device/driver; do
    case "$(basename "$(readlink -f "$d" 2>/dev/null)")" in vmwgfx|virtio_gpu|virtio-pci|vboxvideo|qxl|bochs-drm|bochs|cirrus|hyperv_drm) return 0 ;; esac
  done
  grep -qixE '0x(80ee|15ad|1af4|1234|1b36|1414)' /sys/bus/pci/devices/*/vendor 2>/dev/null && return 0
  cat /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/product_name /sys/class/dmi/id/board_vendor 2>/dev/null \
    | grep -qiE 'virtualbox|innotek|oracle|qemu|vmware|parallels|kvm|hyper-v|microsoft corporation|utm|apple virtualization'
}
EQUIPO="$(cat "$CFG/equipo" 2>/dev/null || cat /etc/bc/equipo 2>/dev/null)"
if [ "$EQUIPO" != vm ] && [ "$EQUIPO" != fisico ]; then if es_vm; then EQUIPO=vm; else EQUIPO=fisico; fi; fi
export BC_EQUIPO="$EQUIPO"

# ¿Hay aceleración 3D de verdad? (renderD y un renderizador OpenGL que no sea por software)
acelerado() {
  ls /dev/dri/renderD* >/dev/null 2>&1 || return 1
  command -v eglinfo >/dev/null 2>&1 || return 0
  r="$(timeout 5 eglinfo -B 2>/dev/null | grep -m1 -i 'renderer')"
  [ -n "$r" ] || return 1
  echo "$r" | grep -qiE 'llvmpipe|softpipe|swrast|software' && return 1
  # Cualquier GPU de verdad (dedicada o integrada; también NVIDIA con nouveau): Hyprland. Si no arranca o muere
  # enseguida, la sesión pasa sola a sway (más abajo). ~/.config/bc/compositor = sway lo desactiva.
  return 0
}
# GPU de verdad (incluida NVIDIA con nouveau), no OpenGL por software: para las esquinas de swayfx
gpu_real() {
  [ "$EQUIPO" = fisico ] || return 1
  ls /dev/dri/renderD* >/dev/null 2>&1 || return 1
  r="$(timeout 5 eglinfo -B 2>/dev/null | grep -m1 -i 'renderer')"
  [ -n "$r" ] && ! echo "$r" | grep -qiE 'llvmpipe|softpipe|swrast|software'
}
PREF="$(cat "$CFG/compositor" 2>/dev/null)"
COMP=sway
if grep -qw "bc.gpu=0" /proc/cmdline || [ "$PREF" = sway ]; then COMP=sway
# En máquinas virtuales (VirtualBox VMSVGA, VMware…) la «3D» virtual es lenta: sway ligero salvo que se pida Hyprland
elif command -v Hyprland >/dev/null 2>&1 && { grep -qw "bc.gpu=1" /proc/cmdline || [ "$PREF" = hyprland ] || { [ "$EQUIPO" = fisico ] && acelerado; }; }; then COMP=hyprland
fi
{ date; echo "equipo: $EQUIPO  compositor: $COMP  renderD: $(ls /dev/dri 2>&1 | tr '\n' ' ')"
  command -v eglinfo >/dev/null && timeout 5 eglinfo -B 2>/dev/null | grep -i -m3 'renderer'; } > "$LOG" 2>&1

# Aspecto claro/oscuro recordado (GTK)
[ -x /usr/bin/bc-appearance ] && bc-appearance "$(cat "$CFG/appearance" 2>/dev/null || echo dark)" >> "$LOG" 2>&1

sway_software() {
  # Cursor por hardware (plano de cursor): fluido y con el tema McMojave también en VirtualBox. Si en algún equipo
  # no se ve el puntero, «software» en ~/.config/bc/cursor lo vuelve a dibujar por software.
  [ "$(cat "$CFG/cursor" 2>/dev/null)" = software ] && export WLR_NO_HARDWARE_CURSORS=1
  export QT_QUICK_BACKEND=software
  # Sin 3D también hay esquinas redondeadas: swayfx con OpenGL ES por software (llvmpipe), solo esquinas
  # (sin sombras ni desenfoque). Si no arranca o muere enseguida, sway clásico con pixman, que siempre funciona.
  # Opcional (Ajustes ▸ General): por software cuesta mucha CPU, así que de serie se usa pixman, que es lo más fluido
  # Con GPU real (aunque sea modesta: NVIDIA con nouveau, Intel antigua…) las esquinas van por GPU y cuestan poco:
  # swayfx de serie. Sin GPU, solo si se activa en Ajustes ▸ General («si» en ~/.config/bc/esquinas).
  ESQ="$(cat "$CFG/esquinas" 2>/dev/null)"
  GPU=0; gpu_real && GPU=1
  if [ -x /opt/swayfx/bin/sway ] && ! grep -qw "bc.fx=0" /proc/cmdline && { [ "$ESQ" = si ] || { [ $GPU = 1 ] && [ "$ESQ" != no ]; }; }; then
    export BC_FX=ligero
    # Con GPU, BC Shell y las apps Qt también dibujan con OpenGL (la CPU queda libre: sin «your system is too slow»)
    if [ $GPU = 1 ]; then unset WLR_RENDERER WLR_RENDERER_ALLOW_SOFTWARE QT_QUICK_BACKEND; else export WLR_RENDERER=gles2 WLR_RENDERER_ALLOW_SOFTWARE=1; fi
    bc-wm-mode init >> "$LOG" 2>&1
    t1=$(date +%s)
    /opt/swayfx/bin/sway -c "${XDG_RUNTIME_DIR:-/tmp}/bc-sway.conf" >> "$LOG" 2>&1
    r=$?
    [ $r -eq 0 ] || [ $(( $(date +%s) - t1 )) -ge 15 ] && return $r
    echo "swayfx falló al arrancar ($r): sway con pixman" >> "$LOG"
  fi
  export QT_QUICK_BACKEND=software
  export WLR_RENDERER=pixman
  unset BC_FX WLR_RENDERER_ALLOW_SOFTWARE
  bc-wm-mode init >> "$LOG" 2>&1
  sway -c "${XDG_RUNTIME_DIR:-/tmp}/bc-sway.conf" >> "$LOG" 2>&1
}
if [ "$COMP" = hyprland ]; then
  export BC_COMPOSITOR=hyprland
  t0=$(date +%s)
  Hyprland -c /etc/bc/hypr/hyprland.lua >> "$LOG" 2>&1
  rc=$?
  # Si muere enseguida (sin GPU utilizable), se vuelve a intentar con sway por software: nunca de vuelta al login
  if [ $rc -ne 0 ] && [ $(( $(date +%s) - t0 )) -lt 15 ]; then
    echo "Hyprland falló al arrancar ($rc): se usa sway por software" >> "$LOG"
    export BC_COMPOSITOR=sway; sway_software; rc=$?
  fi
else
  export BC_COMPOSITOR=sway
  sway_software; rc=$?
fi
echo "sesión terminada con código $rc" >> "$LOG"
# Bajo greetd (--greetd) al cerrar sesión se vuelve al login; sin greetd (autologin) queda un terminal.
{ [ "$1" = "--greetd" ] || [ -n "$BC_GREETD" ]; } && exit 0
echo "La sesión terminó con código $rc — revisa $LOG"
exec bash
