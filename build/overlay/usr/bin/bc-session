#!/bin/sh
# Sesión gráfica de BC OS.
#  · Con aceleración 3D (GPU real, VirtualBox x86 con «Aceleración 3D», QEMU con virgl): Hyprland, con animaciones
#    fluidas tipo macOS, desenfoque real y sombras. Si Hyprland falla al arrancar, sway por software.
#  · Sin aceleración (p. ej. VirtualBox en Mac ARM): sway por software, ligero y estable.
#  bc.gpu=0 en el kernel (o «sway» en ~/.config/bc/compositor) fuerza sway; bc.gpu=1 o «hyprland», Hyprland.
# «BC clásico»: el escritorio anterior a Golden Gate, elegible en el login.
if [ "$1" = "--classic" ]; then export BC_CLASSIC=1; shift; fi
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/bc"
LOG="$HOME/bc-session.log"
export XCURSOR_THEME=McMojave-cursors XCURSOR_SIZE=24
export LANG="${LANG:-es_ES.UTF-8}" XDG_CURRENT_DESKTOP=BC XDG_SESSION_TYPE=wayland QT_QPA_PLATFORM=wayland

es_vm() {
  systemd-detect-virt --vm -q 2>/dev/null && return 0
  cat /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/product_name /sys/class/dmi/id/board_vendor 2>/dev/null \
    | grep -qiE 'virtualbox|innotek|oracle|qemu|vmware|parallels|kvm|hyper-v|microsoft corporation|utm|apple virtualization'
}
EQUIPO="$(cat "$CFG/equipo" 2>/dev/null || cat /etc/bc/equipo 2>/dev/null)"
if [ "$EQUIPO" != vm ] && [ "$EQUIPO" != fisico ]; then if es_vm; then EQUIPO=vm; else EQUIPO=fisico; fi; fi
export BC_EQUIPO="$EQUIPO"

# ¿Hay aceleración 3D de verdad? (renderD y un renderizador OpenGL que no sea por software)
acelerado() {
  ls /dev/dri/renderD* >/dev/null 2>&1 || return 1
  command -v eglinfo >/dev/null 2>&1 || return 0
  r="$(timeout 5 eglinfo -B 2>/dev/null | grep -m1 -i 'renderer')"
  [ -n "$r" ] || return 1
  echo "$r" | grep -qiE 'llvmpipe|softpipe|swrast|software' && return 1
  return 0
}
PREF="$(cat "$CFG/compositor" 2>/dev/null)"
COMP=sway
if grep -qw "bc.gpu=0" /proc/cmdline || [ "$PREF" = sway ]; then COMP=sway
elif command -v Hyprland >/dev/null 2>&1 && { grep -qw "bc.gpu=1" /proc/cmdline || [ "$PREF" = hyprland ] || acelerado; }; then COMP=hyprland
fi
{ date; echo "equipo: $EQUIPO  compositor: $COMP  renderD: $(ls /dev/dri 2>&1 | tr '\n' ' ')"
  command -v eglinfo >/dev/null && timeout 5 eglinfo -B 2>/dev/null | grep -i -m2 'renderer\|vendor'; } > "$LOG" 2>&1

# Aspecto claro/oscuro recordado (GTK)
[ -x /usr/bin/bc-appearance ] && bc-appearance "$(cat "$CFG/appearance" 2>/dev/null || echo dark)" >> "$LOG" 2>&1

sway_software() {
  export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 QT_QUICK_BACKEND=software
  unset BC_FX
  bc-wm-mode init >> "$LOG" 2>&1
  sway -c "${XDG_RUNTIME_DIR:-/tmp}/bc-sway.conf" >> "$LOG" 2>&1
}
if [ "$COMP" = hyprland ]; then
  export BC_COMPOSITOR=hyprland
  t0=$(date +%s)
  Hyprland -c /etc/bc/hypr/hyprland.lua >> "$LOG" 2>&1
  rc=$?
  # Si muere enseguida (sin GPU utilizable), se vuelve a intentar con sway por software: nunca de vuelta al login
  if [ $rc -ne 0 ] && [ $(( $(date +%s) - t0 )) -lt 15 ]; then
    echo "Hyprland falló al arrancar ($rc): se usa sway por software" >> "$LOG"
    export BC_COMPOSITOR=sway; sway_software; rc=$?
  fi
else
  export BC_COMPOSITOR=sway
  sway_software; rc=$?
fi
echo "sesión terminada con código $rc" >> "$LOG"
# Bajo greetd (--greetd) al cerrar sesión se vuelve al login; sin greetd (autologin) queda un terminal.
{ [ "$1" = "--greetd" ] || [ -n "$BC_GREETD" ]; } && exit 0
echo "La sesión terminó con código $rc — revisa $LOG"
exec bash
