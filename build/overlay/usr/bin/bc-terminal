#!/bin/sh
# Terminal de BC OS: Ghostty; si no está o no puede arrancar (p. ej. sin OpenGL), Alacritty y, si no, foot.
RT="${XDG_RUNTIME_DIR:-/tmp}"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
if command -v ghostty >/dev/null 2>&1 && [ ! -f "$RT/bc-no-ghostty" ]; then
  t0=$(date +%s)
  if [ -f "$CFG/ghostty/config" ]; then ghostty "$@" && exit 0
  else ghostty --config-default-files=false --config-file=/etc/bc/ghostty.conf "$@" && exit 0; fi
  # Si falló nada más arrancar, se recuerda durante la sesión y se pasa a la siguiente
  [ $# -eq 0 ] && [ $(( $(date +%s) - t0 )) -lt 4 ] && : > "$RT/bc-no-ghostty" || exit 0
fi
ACFG="$CFG/alacritty/alacritty.toml"; [ -f "$ACFG" ] || ACFG=/etc/bc/alacritty.toml
# Paleta según el aspecto (la mantiene bc-appearance; si falta, se crea ahora)
[ -f "$CFG/bc/alacritty-colores.toml" ] || { mkdir -p "$CFG/bc"; if [ "$(cat "$CFG/bc/appearance" 2>/dev/null)" = light ]; then
  cp /etc/bc/alacritty-claro.toml "$CFG/bc/alacritty-colores.toml" 2>/dev/null; else cp /etc/bc/alacritty-oscuro.toml "$CFG/bc/alacritty-colores.toml" 2>/dev/null; fi; }
if command -v alacritty >/dev/null 2>&1 && [ ! -f "$RT/bc-no-alacritty" ]; then
  t0=$(date +%s)
  alacritty --config-file "$ACFG" "$@" && exit 0
  [ $# -eq 0 ] && [ $(( $(date +%s) - t0 )) -lt 4 ] && : > "$RT/bc-no-alacritty" || exit 0
fi
exec foot "$@"
