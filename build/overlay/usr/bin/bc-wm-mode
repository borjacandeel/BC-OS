#!/bin/sh
# Alterna BC OS entre ventanas flotantes (como macOS) y mosaico (como bspwm). Uso: bc-wm-mode toggle|tiling|floating|init|status
D="${XDG_CONFIG_HOME:-$HOME/.config}/bc"
mkdir -p "$D"
cur=floating
[ -f "$D/layout-mode" ] && cur="$(cat "$D/layout-mode")"
case "$cur" in tiling|floating) ;; *) cur=floating ;; esac
case "$1" in
  toggle) [ "$cur" = tiling ] && new=floating || new=tiling ;;
  tiling|floating) new="$1" ;;
  init) new="$cur" ;;
  status) echo "$cur"; exit 0 ;;
  *) echo "uso: bc-wm-mode toggle|tiling|floating|init|status" >&2; exit 2 ;;
esac
if [ "$new" = tiling ]; then
  printf '# generado por bc-wm-mode: mosaico\nfor_window [app_id=".*"] floating disable\nfor_window [class=".*"] floating disable\ngaps inner 10\ngaps outer 10\ngaps bottom 10\n' > "$D/sway-mode.conf"
else
  printf '# generado por bc-wm-mode: flotante\nfor_window [app_id=".*"] floating enable\nfor_window [class=".*"] floating enable\ngaps inner 0\ngaps outer 0\ngaps bottom 0\n' > "$D/sway-mode.conf"
fi
echo "$new" > "$D/layout-mode.tmp.$$" && mv "$D/layout-mode.tmp.$$" "$D/layout-mode"
# Configuración final de sway = sistema + teclado + modo + usuario (sin «include», que no es fiable)
OUT="${XDG_RUNTIME_DIR:?sin XDG_RUNTIME_DIR}/bc-sway.conf"
{ cat /etc/bc/sway/config; [ -f /etc/bc/sway/keyboard.conf ] && cat /etc/bc/sway/keyboard.conf
  # Distribución de teclado elegida en Ajustes del Sistema ▸ Teclado (solo letras: es, us, gb, fr, de, it, pt, latam)
  kl=$(cat "$D/keyboard-layout" 2>/dev/null); case "$kl" in es|us|gb|fr|de|it|pt|latam) printf 'input type:keyboard xkb_layout %s\n' "$kl" ;; esac
  [ -n "$BC_FX" ] && [ -f /etc/bc/sway/efectos.conf ] && cat /etc/bc/sway/efectos.conf
  WP=/usr/share/bc/wallpapers/ondas.jpg
  [ -f "$D/wallpaper" ] && w=$(head -n1 "$D/wallpaper") && [ -f "$w" ] && WP=$w
  case $WP in *\"*|*\\*|*\$*|*\;*|*,*|*\'*|*\`*) WP=/usr/share/bc/wallpapers/ondas.jpg ;; esac
  case $WP in *"
"*) WP=/usr/share/bc/wallpapers/ondas.jpg ;; esac
  printf 'output * bg "%s" fill #04111F\n' "$WP"
  cat "$D/sway-mode.conf"
  [ "$(cat "$D/appearance" 2>/dev/null)" = light ] && cat /etc/bc/sway/claro.conf 2>/dev/null
  printf 'for_window [window_role="pop-up"] floating enable\nfor_window [window_type="dialog"] floating enable\n'
  [ -f "$D/sway-user.conf" ] && cat "$D/sway-user.conf"; true; } > "$OUT.tmp.$$" && mv "$OUT.tmp.$$" "$OUT"
[ "$1" = init ] && exit 0
# En caliente no se recarga sway (recargar reinicia el fondo y parpadea): se aplican las reglas por IPC.
if [ -n "$SWAYSOCK" ]; then
  if [ "$new" = tiling ]; then
    swaymsg 'for_window [app_id=".*"] floating disable; for_window [class=".*"] floating disable' >/dev/null 2>&1
    swaymsg '[app_id=".*"] floating disable; [class=".*"] floating disable' >/dev/null 2>&1
    swaymsg 'gaps inner all set 10; gaps outer all set 10; gaps bottom all set 10' >/dev/null 2>&1
  else
    swaymsg 'for_window [app_id=".*"] floating enable; for_window [class=".*"] floating enable' >/dev/null 2>&1
    swaymsg '[app_id=".*"] floating enable; [class=".*"] floating enable' >/dev/null 2>&1
    swaymsg 'gaps inner all set 0; gaps outer all set 0; gaps bottom all set 0' >/dev/null 2>&1
  fi
fi
exit 0
