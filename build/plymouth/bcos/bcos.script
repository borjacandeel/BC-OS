# Tema Plymouth BC OS: orbes de color en movimiento, logo que crece con destello y respira, barra como macOS.
# Sin 3D: solo sprites 2D (framebuffer/DRM simple).

sw = Window.GetWidth();
sh = Window.GetHeight();


# Arranque «Golden Gate»: fondo negro, tres orbes de color difusos que flotan despacio, el logo aparece creciendo
# con suavidad (de 88 % a 100 %) y un destello de luz lo recorre; después respira. Todo con sprites 2D.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0.012, 0.016, 0.035);

base_logo = Image("logo.png");
lw = sw * 0.24;
if (lw < 220) lw = 220;
if (lw > 400) lw = 400;
lh = base_logo.GetHeight() * lw / base_logo.GetWidth();
logo_img = base_logo.Scale(lw, lh);
cx = sw / 2;
cy = sh * 0.45;
logo_x = cx - lw / 2;
logo_y = cy - lh / 2;

# Orbes de color (se mueven en órbitas lentas y distintas)
osz = sh * 0.9;
orb_imgs[0] = Image("orbe-azul.png").Scale(osz, osz);
orb_imgs[1] = Image("orbe-violeta.png").Scale(osz * 0.85, osz * 0.85);
orb_imgs[2] = Image("orbe-cian.png").Scale(osz * 0.6, osz * 0.6);
for (i = 0; i < 3; i++) {
  orbs[i] = Sprite(orb_imgs[i]);
  orbs[i].SetZ(-20 + i);
  orbs[i].SetOpacity(0);
}

glow_size = sh * 0.9;
glow = Sprite(Image("glow.png").Scale(glow_size, glow_size));
glow.SetX(cx - glow_size / 2);
glow.SetY(cy - glow_size / 2);
glow.SetZ(-10);
glow.SetOpacity(0);

# Logo: versiones escaladas precalculadas para el crecimiento inicial (sin reescalar en cada fotograma)
for (i = 0; i <= 12; i++) {
  k = 0.88 + 0.12 * i / 12;
  logo_steps[i] = base_logo.Scale(lw * k, lh * k);
}
logo = Sprite(logo_steps[0]);
logo.SetZ(10);
logo.SetOpacity(0);

# Destello (24 fotogramas) sobre el logo
for (i = 0; i < 24; i++) {
  if (i < 10) n = "0" + i; else n = "" + i;
  shine_imgs[i] = Image("brillo-" + n + ".png").Scale(lw, lh);
}
shine = Sprite(shine_imgs[0]);
shine.SetX(logo_x);
shine.SetY(logo_y);
shine.SetZ(11);
shine.SetOpacity(0);

# Barra de progreso inferior
bar_w = 200;
if (sw < 480) bar_w = sw * 0.6;
bar_h = 5;
bar_x = cx - bar_w / 2;
bar_y = cy + lh / 2 + sh * 0.09;

track_img = Image("bar-track.png").Scale(bar_w, bar_h);
track = Sprite(track_img);
track.SetX(bar_x);
track.SetY(bar_y);
track.SetZ(20);
track.SetOpacity(0);

fill_src = Image("bar-fill.png");
fill = Sprite();
fill.SetX(bar_x);
fill.SetY(bar_y);
fill.SetZ(21);
fill.SetOpacity(0);

# Mensajes y contraseña
msg = Sprite();
msg.SetZ(30);
pw_label = Sprite();
pw_label.SetZ(30);
bullets = [];
bullet_img = Image("bullet.png");

fun center_text(sprite, text, y, alpha) {
  img = Image.Text(text, 0.75, 0.78, 0.84, alpha);
  sprite.SetImage(img);
  sprite.SetX(cx - img.GetWidth() / 2);
  sprite.SetY(y);
}

frame = 0;
progress_target = 0;
progress_now = 0;
last_w = 0;

fun smooth(x) {
  if (x < 0) x = 0;
  if (x > 1) x = 1;
  return x * x * (3 - 2 * x);
}

fun refresh() {
  frame++;
  t = frame / 50.0;                       # segundos aprox. (~50 Hz)

  # Orbes: entran en 2 s y flotan
  of = smooth(t / 2.0);
  orbs[0].SetX(cx - osz / 2 + Math.Sin(t * 0.35) * sw * 0.16 - sw * 0.10);
  orbs[0].SetY(cy - osz / 2 + Math.Cos(t * 0.30) * sh * 0.10);
  orbs[1].SetX(cx - osz * 0.425 + Math.Cos(t * 0.27 + 1.5) * sw * 0.18 + sw * 0.10);
  orbs[1].SetY(cy - osz * 0.425 + Math.Sin(t * 0.33 + 0.7) * sh * 0.12);
  orbs[2].SetX(cx - osz * 0.3 + Math.Sin(t * 0.45 + 3.0) * sw * 0.12);
  orbs[2].SetY(cy - osz * 0.3 + Math.Cos(t * 0.40 + 2.0) * sh * 0.16 + sh * 0.06);
  for (i = 0; i < 3; i++) orbs[i].SetOpacity(of * (0.55 + 0.15 * Math.Sin(t * 0.8 + i * 2)));

  # Logo: aparece creciendo (0,3 s → 1,5 s) con curva suave
  lf = smooth((t - 0.3) / 1.2);
  si = Math.Int(lf * 12);
  img = logo_steps[si];
  logo.SetImage(img);
  logo.SetX(cx - img.GetWidth() / 2);
  logo.SetY(cy - img.GetHeight() / 2);
  breath = (Math.Sin((t - 1.5) * 1.6) + 1) / 2;
  if (t < 1.5) breath = 1;
  logo.SetOpacity(lf * (0.92 + 0.08 * breath));
  glow.SetOpacity(lf * (0.35 + 0.30 * breath));

  # Destello: recorre el logo a los 1,6 s y luego cada 4 s
  st = t - 1.6;
  if (st > 0) {
    ph = st - Math.Int(st / 4.0) * 4.0;
    if (ph < 0.9) {
      shine.SetImage(shine_imgs[Math.Int(ph / 0.9 * 23)]);
      shine.SetOpacity(0.85);
    } else shine.SetOpacity(0);
  }

  # Barra: aparece tras 1,2 s y avanza suave hacia el progreso real
  bar_fade = smooth((t - 1.2) / 0.8);
  track.SetOpacity(bar_fade);
  progress_now = progress_now + (progress_target - progress_now) * 0.08;
  w = Math.Int(bar_w * progress_now);
  if (w < 5) w = 5;
  if (w != last_w) {
    fill.SetImage(fill_src.Scale(w, bar_h));
    last_w = w;
  }
  fill.SetOpacity(bar_fade);
}
Plymouth.SetRefreshFunction(refresh);

fun progress_cb(duration, progress) {
  if (progress > 1) progress = 1;
  if (progress > progress_target) progress_target = progress;
}
Plymouth.SetBootProgressFunction(progress_cb);

# Mensajes de estado (en castellano cuando el sistema los envía así)
fun message_cb(text) {
  center_text(msg, text, bar_y + 28, 0.9);
}
Plymouth.SetMessageFunction(message_cb);
# Como en macOS, solo logo y barra: los nombres de servicios (estado de systemd) no se muestran

# Contraseña de cifrado (instalación con LUKS)
fun password_cb(prompt, count) {
  center_text(pw_label, "Introduce la contraseña de cifrado", bar_y - 70, 1.0);
  for (i = 0; bullets[i]; i++) bullets[i] = NULL;
  for (i = 0; i < count && i < 24; i++) {
    bullets[i] = Sprite(bullet_img);
    bullets[i].SetX(cx - (count * 16) / 2 + i * 16);
    bullets[i].SetY(bar_y - 40);
    bullets[i].SetZ(31);
  }
}
Plymouth.SetDisplayPasswordFunction(password_cb);

fun normal_cb() {
  pw_label.SetOpacity(0);
  for (i = 0; bullets[i]; i++) bullets[i] = NULL;
}
Plymouth.SetDisplayNormalFunction(normal_cb);

fun quit_cb() {
  progress_target = 1;
}
Plymouth.SetQuitFunction(quit_cb);
