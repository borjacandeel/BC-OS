#!/bin/sh
# Actualiza BC OS desde su repositorio propio ([bc], GitHub Releases) y Arch Linux ARM.
# La primera vez adopta los archivos de BC que puso la imagen (--overwrite solo en rutas de BC).
set -e
set -f   # los patrones de --overwrite no se expanden en el shell
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
grep -q '^\[bc\]' /etc/pacman.conf || { echo "Falta el repositorio [bc] en /etc/pacman.conf" >&2; exit 1; }
OV="--overwrite /usr/bin/bc-* --overwrite /usr/share/bc/* --overwrite /usr/share/applications/bc-* --overwrite /etc/bc/*"
OV="$OV --overwrite /usr/share/icons/hicolor/scalable/apps/bc-* --overwrite /usr/share/sounds/bc/* --overwrite /usr/lib/systemd/user/bc-*"
OV="$OV --overwrite /etc/systemd/user/default.target.wants/bc-* --overwrite /usr/lib/bc/* --overwrite /usr/share/libalpm/hooks/00-bc-* --overwrite /usr/share/polkit-1/actions/org.bcos.* --overwrite /etc/polkit-1/rules.d/50-bcos-*"
OV="$OV --overwrite /usr/share/plymouth/themes/bcos/* --overwrite /usr/lib/tmpfiles.d/bc-*"
OV="$OV --overwrite /etc/fish/functions/* --overwrite /etc/fish/conf.d/bcos.fish --overwrite /usr/share/fish/tools/web_config/themes/BC-*"
OV="$OV --overwrite /usr/lib/firefox/distribution/policies.json --overwrite /usr/lib/firefox/defaults/pref/bc-* --overwrite /usr/lib/firefox/bc*"
# Huella del tema de arranque antes de actualizar: si cambia, se rehace el initramfs (el arranque animado va en él)
ply0="$(cat /usr/share/plymouth/themes/bcos/* 2>/dev/null | md5sum)"
pacman -Syy --noconfirm
# Todos los archivos que traen los paquetes de BC (lista del repositorio [bc]) se pueden sobrescribir: así un archivo
# que la imagen puso a mano y ahora llega en un paquete nunca bloquea la actualización (solo rutas de BC, nunca otras)
pacman -Fy >/dev/null 2>&1 || true
for f in $(pacman -Flq bc-os bc-shell bc-core bc-escritorio 2>/dev/null | grep -v '/$'); do OV="$OV --overwrite /$f"; done
if pacman -Qq bc-os >/dev/null 2>&1; then pacman -Su --noconfirm $OV "$@"
else pacman -S --noconfirm --needed $OV bc-os "$@" && pacman -Su --noconfirm "$@"; fi
systemd-tmpfiles --create /usr/lib/tmpfiles.d/bc-greeter.conf 2>/dev/null || true
if [ "$(cat /usr/share/plymouth/themes/bcos/* 2>/dev/null | md5sum)" != "$ply0" ] && command -v mkinitcpio >/dev/null 2>&1; then
  echo "Actualizando el arranque animado…"; plymouth-set-default-theme bcos 2>/dev/null; mkinitcpio -P >/dev/null 2>&1 || true
fi
echo "Cierra sesión (o reinicia) para usar las novedades del escritorio."
# En el login solo BC OS y Dotfiles
rm -f /usr/share/bc/sessions/bc-clasico.desktop
gtk-update-icon-cache -q -f /usr/share/icons/hicolor 2>/dev/null || true
echo "BC OS actualizado. Ya puedes cerrar esta ventana."
