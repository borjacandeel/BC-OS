[Unit]
# Solo para personas: no en el usuario del login (greetd), que no tiene carpeta personal (%h = «/»)
ConditionUser=!@system
Description=BC OS — Daemon coordinador
Documentation=https://github.com/borjacandeel/BC-OS

[Service]
Type=dbus
BusName=org.bcos.Daemon
ExecStart=/usr/bin/bc-daemon
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
