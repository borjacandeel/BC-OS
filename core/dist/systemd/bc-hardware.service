[Unit]
Description=BC OS — Servicio de hardware
Documentation=https://github.com/borjacandeel/BC-OS

[Service]
Type=dbus
BusName=org.bcos.Hardware
# Caché del perfil gráfico (BC Adaptive Renderer): única ruta escribible
ExecStartPre=/usr/bin/mkdir -p %h/.cache/bc
ExecStart=/usr/bin/bc-hardware-service
ReadWritePaths=%h/.cache/bc
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
