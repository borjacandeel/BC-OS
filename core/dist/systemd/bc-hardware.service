[Unit]
# Solo para personas: no en el usuario del login (greetd), que no tiene carpeta personal (%h = «/»)
ConditionUser=!@system
Description=BC OS — Servicio de hardware
Documentation=https://github.com/borjacandeel/BC-OS

[Service]
Type=dbus
BusName=org.bcos.Hardware
# Caché del perfil gráfico (BC Adaptive Renderer): ~/.cache/bc, creada y abierta a escritura por systemd.
# (Antes ReadWritePaths=%h/.cache/bc fallaba con 226/NAMESPACE si la carpeta no existía aún: servicio caído)
CacheDirectory=bc
ExecStart=/usr/bin/bc-hardware-service
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
