[Unit]
# Solo para personas: no en el usuario del login (greetd), que no tiene carpeta personal (%h = «/»)
ConditionUser=!@system
Description=BC OS — Servicio de rendimiento
Documentation=https://github.com/borjacandeel/BC-OS

[Service]
Type=dbus
BusName=org.bcos.Performance
ExecStart=/usr/bin/bc-performance-service
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
