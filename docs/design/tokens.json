{
  "$schema": "bc-os-design-tokens-v1",
  "version": "0.1.0",
  "note": "Valores ≈ estimados sobre docs/design/reference/escritorio-referencia-01.webp; afinar al implementar.",
  "color": {
    "brand": {
      "nightBlue": "#04111F",
      "white": "#F5F5F7",
      "silver": { "top": "#F6F8FC", "mid": "#D5DCE8", "bottom": "#A1ADC0" },
      "midnight": { "center": "#3A4A66", "edge": "#0B1019" }
    },
    "semantic": {
      "success": "#30D158",
      "warning": "#FFB340",
      "danger": "#FF5F57",
      "info": "#2F7BFF"
    },
    "windowButtons": { "close": "#FF5F57", "minimize": "#FEBC2E", "maximize": "#28C840" },
    "dark": {
      "accent": "#2F7BFF",
      "accentHover": "#4D8FFF",
      "accentPressed": "#1F63D6",
      "surfaceWindow": "rgba(22,33,58,0.82)",
      "surfaceSidebar": "rgba(27,39,66,0.70)",
      "surfacePanel": "rgba(16,26,48,0.78)",
      "surfaceControl": "rgba(255,255,255,0.08)",
      "surfaceControlHover": "rgba(255,255,255,0.14)",
      "borderSubtle": "rgba(255,255,255,0.12)",
      "textPrimary": "#F5F5F7",
      "textSecondary": "rgba(245,245,247,0.62)",
      "textDisabled": "rgba(245,245,247,0.38)",
      "scrim": "rgba(4,17,31,0.20)"
    },
    "light": {
      "accent": "#0A64F0",
      "accentHover": "#2F7BFF",
      "accentPressed": "#0850C4",
      "surfaceWindow": "rgba(244,246,250,0.86)",
      "surfaceSidebar": "rgba(232,236,243,0.78)",
      "surfacePanel": "rgba(255,255,255,0.80)",
      "surfaceControl": "rgba(0,0,0,0.06)",
      "surfaceControlHover": "rgba(0,0,0,0.10)",
      "borderSubtle": "rgba(0,0,0,0.10)",
      "textPrimary": "#0B1220",
      "textSecondary": "rgba(11,18,32,0.62)",
      "textDisabled": "rgba(11,18,32,0.38)",
      "scrim": "rgba(255,255,255,0.10)"
    },
    "folder": { "top": "#3B9BFF", "bottom": "#1E7BF0" }
  },
  "typography": {
    "family": { "ui": "Inter", "uiFallback": "Noto Sans", "mono": "JetBrains Mono" },
    "scale": {
      "display": { "size": 32, "line": 38, "weight": 700 },
      "title1": { "size": 22, "line": 28, "weight": 600 },
      "title2": { "size": 17, "line": 22, "weight": 600 },
      "body": { "size": 14, "line": 20, "weight": 400 },
      "bodyEmphasis": { "size": 14, "line": 20, "weight": 600 },
      "caption": { "size": 12, "line": 16, "weight": 400 },
      "mono": { "size": 13, "line": 18, "weight": 400 },
      "tagline": { "size": 13, "line": 16, "weight": 500, "tracking": "0.2em", "case": "upper" }
    }
  },
  "space": { "0": 0, "0.5": 2, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "12": 48, "16": 64 },
  "radius": { "xs": 6, "sm": 10, "md": 14, "lg": 22, "xl": 28, "pill": 999 },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(0,0,0,0.25)",
    "2": "0 8px 24px rgba(0,0,0,0.35)",
    "3": "0 24px 64px rgba(0,0,0,0.45)"
  },
  "blur": { "radiusPx": 24, "downscale": 0.5, "maxStackedLayers": 3 },
  "size": {
    "topBarHeight": 40,
    "windowTitleBarHeight": 52,
    "sidebarWidth": 240,
    "sidebarRowHeight": 40,
    "controlHeight": 32,
    "searchHeight": 36,
    "dockIcon": 70,
    "dockGap": 14,
    "dockBottomMargin": 12,
    "dockMaxMagnification": 1.6,
    "controlCenterWidth": 380,
    "controlTile": { "w": 108, "h": 124 },
    "notification": { "w": 320, "h": 80 },
    "windowMin": { "w": 480, "h": 320 },
    "windowButton": 22,
    "icon": { "ui": [16, 20, 24, 32], "app": [48, 64, 128, 256] },
    "minTarget": 32
  },
  "motion": {
    "duration": { "instant": 80, "fast": 140, "base": 220, "slow": 320, "overview": 380 },
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "enter": [0, 0, 0, 1],
      "exit": [0.3, 0, 1, 1],
      "spring": { "damping": 0.82, "stiffness": 260 }
    },
    "reduced": { "durationMaxMs": 80, "magnification": false, "parallax": false }
  },
  "accessibility": {
    "contrastText": 4.5,
    "contrastLargeAndIcons": 3,
    "focusRing": { "width": 2, "offset": 2, "color": "accent" },
    "textScale": { "min": 0.8, "max": 2.0 },
    "highContrast": { "borderWidth": 2, "opaqueSurfaces": true }
  }
}
