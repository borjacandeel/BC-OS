[Icon Theme]
Name=Qogir
Comment=Qogir icon theme (vinceliuice, GPL-3.0). Subconjunto vectorial incluido en BC OS.
Inherits=hicolor
Example=folder

Directories=scalable/apps,scalable/devices,scalable/places,scalable/mimetypes,scalable/status

[scalable/apps]
Context=Applications
Size=48
MinSize=8
MaxSize=512
Type=Scalable

[scalable/devices]
Context=Devices
Size=48
MinSize=8
MaxSize=512
Type=Scalable

[scalable/places]
Context=Places
Size=48
MinSize=8
MaxSize=512
Type=Scalable

[scalable/mimetypes]
Context=MimeTypes
Size=48
MinSize=8
MaxSize=512
Type=Scalable

[scalable/status]
Context=Status
Size=48
MinSize=8
MaxSize=512
Type=Scalable
